<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Calculateur praticables</title>

<link rel="apple-touch-icon" href="icone.jpg">

<style>
body{
font-family:Arial;
margin:0;
padding:10px;
background:#6a5acd;
color:white;
}

.card{
background:white;
color:black;
padding:10px;
border-radius:10px;
margin-bottom:10px;
}

button{
padding:10px;
margin-top:5px;
width:100%;
}
</style>

</head>

<body>

<h1>Praticables</h1>

<div class="card">
<button onclick="addModule()">Ajouter module</button>
</div>

<div class="card" id="modules"></div>

<script>

let modules=[];

function addModule(){
modules.push("ok");
render();
}

function render(){
document.getElementById("modules").innerHTML =
"Modules : " + modules.length;
}

document.addEventListener("DOMContentLoaded", render);

</script>

</body>
</html>